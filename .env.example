# ==============================================================================
# BUSCA BUSCA — Variáveis de Ambiente (.env.example)
# ==============================================================================
# ATENÇÃO: NUNCA insira credenciais reais neste arquivo ou em repositórios públicos.
# No Vercel, configure em: Project Settings -> Environment Variables
# Após alterar variáveis na Vercel, é necessário um novo deploy para terem efeito.

# Credenciais da API Oficial de Afiliados Shopee (https://affiliate.shopee.com.br/open_api/home)
SHOPEE_APP_ID="seu_shopee_app_id_aqui"
SHOPEE_APP_SECRET="seu_shopee_app_secret_aqui"

# Chave mestra para acesso ao Painel Administrativo e Diagnósticos (/admin)
# Defina uma string forte para proteger endpoints administrativos
ADMIN_SECRET_KEY="sua_chave_admin_secreta_super_segura"

# Porta do servidor (padrão 3000)
PORT="3000"

# URL pública da aplicação (injetada automaticamente na Vercel ou AI Studio)
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Opcional se for utilizar modelos Gemini
GEMINI_API_KEY=""
